# WorkBuddy Commercial GA v1.0
# Copy to .env. Never commit real credentials.

WORKBUDDY_ENVIRONMENT=local
WORKBUDDY_DATABASE_URL=sqlite:///./workbuddy.db
WORKBUDDY_APP_SECRET=replace-with-at-least-32-random-characters
WORKBUDDY_TOKEN_ENCRYPTION_KEY=
WORKBUDDY_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
WORKBUDDY_PUBLIC_BASE_URL=http://localhost:8000
WORKBUDDY_OBJECT_STORE_DIR=./var/objects
WORKBUDDY_CONFIG_DIR=./config

# Model gateway. deterministic works offline. Use openai only with a valid key.
WORKBUDDY_MODEL_PROVIDER=deterministic
WORKBUDDY_MODEL_NAME=gpt-5-mini
WORKBUDDY_MODEL_BASE_URL=https://api.openai.com/v1
WORKBUDDY_MODEL_API_KEY=
WORKBUDDY_MODEL_TIMEOUT_SECONDS=60
WORKBUDDY_MODEL_MAX_OUTPUT_TOKENS=4000
# Currency unit: Chinese fen. 10000 = ¥100/day.
WORKBUDDY_MODEL_DAILY_BUDGET_CNY_FEN=10000
WORKBUDDY_MODEL_INPUT_COST_CNY_FEN_PER_MILLION=0
WORKBUDDY_MODEL_OUTPUT_COST_CNY_FEN_PER_MILLION=0

# Gmail OAuth and Pub/Sub.
WORKBUDDY_GMAIL_CLIENT_ID=
WORKBUDDY_GMAIL_CLIENT_SECRET=
WORKBUDDY_GMAIL_REDIRECT_URI=http://localhost:8000/v1/connectors/gmail/callback
WORKBUDDY_GMAIL_TOPIC_NAME=
WORKBUDDY_GMAIL_PUBSUB_VERIFICATION_TOKEN=

# Microsoft Graph / Entra ID.
WORKBUDDY_GRAPH_CLIENT_ID=
WORKBUDDY_GRAPH_CLIENT_SECRET=
WORKBUDDY_GRAPH_TENANT=common
WORKBUDDY_GRAPH_REDIRECT_URI=http://localhost:8000/v1/connectors/graph/callback
WORKBUDDY_GRAPH_WEBHOOK_CLIENT_STATE=
WORKBUDDY_GRAPH_SUBSCRIPTION_HOURS=70

# Controlled live email. Safe defaults are intentionally restrictive.
WORKBUDDY_ENABLE_LIVE_EMAIL_SEND=false
WORKBUDDY_REQUIRE_PILOT_FOR_LIVE_SEND=false
WORKBUDDY_ALLOWED_RECIPIENT_DOMAINS=
WORKBUDDY_ALLOWED_RECIPIENT_ADDRESSES=
WORKBUDDY_DAILY_SEND_LIMIT=20
WORKBUDDY_MISSION_SEND_LIMIT=3
WORKBUDDY_ALLOW_BCC=false
WORKBUDDY_ALLOW_ATTACHMENTS=false

# Pilot behavior.
WORKBUDDY_DISPATCH_SHADOW_MODE=true
WORKBUDDY_DISPATCH_AUTO_ROUTE_MIN_CONFIDENCE=95
WORKBUDDY_WORKER_POLL_SECONDS=5

# Production identity. local_headers is allowed only for local development.
WORKBUDDY_AUTH_MODE=local_headers
WORKBUDDY_AUTH_JWT_SECRET=
WORKBUDDY_AUTH_JWT_ALGORITHM=HS256
WORKBUDDY_AUTH_OIDC_ISSUER=
WORKBUDDY_AUTH_OIDC_AUDIENCE=
WORKBUDDY_AUTH_JWKS_URL=
WORKBUDDY_AUTH_TENANT_CLAIM=tenant_id
WORKBUDDY_AUTH_ROLES_CLAIM=roles

# Production operations.
WORKBUDDY_BACKUP_BUCKET=
WORKBUDDY_ALERT_WEBHOOK_URL=
WORKBUDDY_PILOT_NAME=WorkBuddy Production Pilot

# Evidence/artifact storage. filesystem is local-only; use s3 in staging/production.
WORKBUDDY_OBJECT_STORE_PROVIDER=filesystem
WORKBUDDY_OBJECT_STORE_BUCKET=
WORKBUDDY_OBJECT_STORE_REGION=
WORKBUDDY_OBJECT_STORE_ENDPOINT=

# Commercial GA. Keep pricing unapproved until formal business sign-off.
WORKBUDDY_COMMERCIAL_PRICING_APPROVED=false
WORKBUDDY_BILLING_PROVIDER=manual
WORKBUDDY_BILLING_WEBHOOK_SECRET=

# Tax engine (Gap 2). Region code drives VAT/GST rate lookup.
WORKBUDDY_TAX_DEFAULT_REGION=CN

# Stripe payment provider (Gap 2). Leave empty to use manual billing.
WORKBUDDY_STRIPE_API_KEY=
WORKBUDDY_STRIPE_WEBHOOK_SECRET=
WORKBUDDY_STRIPE_API_BASE_URL=https://api.stripe.com/v1

# Object store and database encryption (Gap 4). Configure KMS key ARN for SSE-KMS.
WORKBUDDY_OBJECT_STORE_KMS_KEY_ARN=
WORKBUDDY_DB_ENCRYPTION_KEY_REF=

# Cloud infrastructure references (Gap 3). Required for production deployment.
WORKBUDDY_GCP_PROJECT_ID=
WORKBUDDY_GCP_REGION=asia-east2
WORKBUDDY_ENTRA_TENANT_ID=
WORKBUDDY_WORKLOAD_IDENTITY_POOL=
